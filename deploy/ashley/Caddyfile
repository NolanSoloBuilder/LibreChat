ashley.forgepane.com {
  encode zstd gzip
  @noLanguage {
    method GET
    path / /login /register /c/*
    not header Cookie *lang=*
  }
  header @noLanguage Set-Cookie "lang=en; Path=/; SameSite=Lax; Secure"
  header {
    X-Robots-Tag "noindex, nofollow"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  reverse_proxy api:3080 {
    flush_interval -1
  }
}
